{
  "name": "my-sails-sample",
  "private": true,
  "version": "0.0.0",
  "description": "a Sails application",
  "keywords": [],
  "dependencies": {
    "sails": "^1.5.17",
    "sails-hook-orm": "^4.0.3",
    "sails-hook-sockets": "^3.0.0",
    "sails-mysql": "^3.0.1"
  },
  "devDependencies": {
    "@sailshq/lodash": "^3.10.7",
    "@testing-library/dom": "^10.4.1",
    "coverage-badges-cli": "^2.2.0",
    "eslint": "^10.0.2",
    "@eslint/js": "^10.0.1",
    "globals": "^17.3.0",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9",
    "jsdom": "^25.0.1",
    "@vitest/coverage-v8": "^2.1.9"
  },
  "scripts": {
    "start": "NODE_ENV=production node app.js",
